@model MediPulses.DAL.Entities.User

@{
    ViewData["Title"] = "Delete User";
    var initial     = string.IsNullOrEmpty(Model.Name) ? "?" : Model.Name[0].ToString().ToUpper();
    var colors      = new[] { "#6366f1","#0ea5e9","#10b981","#f59e0b","#ef4444","#8b5cf6","#ec4899" };
    var avatarColor = colors[Math.Abs((Model.Name ?? "?").GetHashCode()) % colors.Length];

    string roleCss = Model.Role switch {
        "Admin"                                => "bg-danger",
        "Clinical Supply Manager"              => "bg-primary",
        "Pharmacy Manager"                     => "bg-success",
        "Biomedical Engineer / Device Manager" => "bg-info text-dark",
        "Procurement Officer"                  => "bg-warning text-dark",
        "Cold Chain Operator"                  => "bg-info",
        "Nursing / Ward Staff"                 => "bg-pink",
        "Compliance Officer"                   => "bg-secondary",
        _                                      => "bg-secondary"
    };
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">

            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Index" class="text-decoration-none">Admin Dashboard</a></li>
                    <li class="breadcrumb-item active text-danger">Delete User</li>
                </ol>
            </nav>

            <div class="delete-card">
                <div class="card-header d-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                    <h5 class="mb-0 fw-semibold">Confirm Deletion</h5>
                </div>
                <div class="card-body p-4">

                    <div class="alert alert-danger d-flex align-items-center gap-2 rounded-3 mb-3">
                        <i class="bi bi-exclamation-circle-fill fs-5 flex-shrink-0"></i>
                        <div><strong>Warning!</strong> This action cannot be undone.</div>
                    </div>

                    <p class="text-muted mb-3 small">You are about to permanently delete the following user account:</p>

                    <div class="bg-light rounded-3 p-3 mb-4">
                        <div class="d-flex align-items-center gap-3 mb-2">
                            <div style="width:42px;height:42px;border-radius:10px;background:@avatarColor;
                                        display:flex;align-items:center;justify-content:center;
                                        font-size:1.1rem;font-weight:700;color:#fff;flex-shrink:0;">
                                @initial
                            </div>
                            <div>
                                <div class="fw-bold">@Model.Name</div>
                                <small class="text-muted">@Model.Email &bull; ID: #@Model.UserId</small>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.Role))
                        {
                            <span class="badge @roleCss badge-status">
                                <i class="bi bi-person-badge me-1"></i>@Model.Role
                            </span>
                        }
                    </div>

                    <form asp-action="Delete" asp-route-id="@Model.UserId" method="post">
                        @Html.AntiForgeryToken()
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger px-4 fw-semibold">
                                <i class="bi bi-trash me-1"></i>Yes, Delete
                            </button>
                            <a asp-action="Index" class="btn btn-light px-4">
                                <i class="bi bi-arrow-left me-1"></i>Cancel
                            </a>
                        </div>
                    </form>

                </div>
            </div>

        </div>
    </div>
</div>
