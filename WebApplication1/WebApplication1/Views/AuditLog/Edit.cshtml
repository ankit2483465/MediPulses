@model MediPulses.DAL.Entities.AuditLog

@{
    ViewData["Title"] = "Edit Audit Log";
}

<div class="container-fluid py-4 px-4">

    <!-- Page Header -->
    <div class="page-header mb-4">
        <div>
            <h2 class="mb-1"><i class="bi bi-pencil-fill me-2"></i>Edit Audit Log</h2>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Audit Logs</a></li>
                    <li class="breadcrumb-item active">Edit</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="data-card">
                <div class="card-header fw-semibold text-secondary small">
                    <i class="bi bi-pencil me-1"></i>Edit Log #@Model.AuditId
                </div>
                <div class="p-4">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="AuditId" />

                        <div class="mb-3">
                            <label asp-for="UserId" class="form-label fw-semibold">User</label>
                            <select asp-for="UserId" asp-items="ViewBag.Users" class="form-select">
                                <option value="">— Select User —</option>
                            </select>
                            <span asp-validation-for="UserId" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Action" class="form-label fw-semibold">Action</label>
                            <input asp-for="Action" class="form-control" placeholder="Describe the action" />
                            <span asp-validation-for="Action" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Timestamp" class="form-label fw-semibold">Timestamp</label>
                            <input asp-for="Timestamp" type="datetime-local" class="form-control"
                                   value="@(Model.Timestamp.HasValue ? Model.Timestamp.Value.ToString("yyyy-MM-ddTHH:mm") : "")" />
                            <span asp-validation-for="Timestamp" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-warning fw-semibold px-4">
                                <i class="bi bi-save me-1"></i>Save Changes
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i>Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
