@model IEnumerable<MediPulses.DAL.Entities.AuditLog>

@{
    ViewData["Title"] = "Audit Logs";
}

<div class="container-fluid py-4 px-4">

    <!-- Page Header -->
    <div class="page-header mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h2 class="mb-1"><i class="bi bi-shield-lock me-2"></i>Audit Logs</h2>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
                        <li class="breadcrumb-item active">Audit Logs</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>

    <!-- Alerts -->
    @if (TempData["SuccessUpdate"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show rounded-3 mb-4 shadow-sm" role="alert">
            <i class="bi bi-pencil-fill me-2"></i>@TempData["SuccessUpdate"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["SuccessDelete"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show rounded-3 mb-4 shadow-sm" role="alert">
            <i class="bi bi-trash-fill me-2"></i>@TempData["SuccessDelete"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Table Card -->
    <div class="data-card">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span class="fw-semibold text-secondary small">
                <i class="bi bi-list-ul me-1"></i>All Audit Logs
                <span class="badge bg-danger ms-2">@((int)ViewBag.TotalCount)</span>
            </span>
            <input type="text" id="searchInput" class="search-box" placeholder="Search logs..." style="width:260px;">
        </div>

        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table" id="auditTable">
                    <thead>
                        <tr>
                            <th style="width:50px">#</th>
                            <th>User</th>
                            <th>Action</th>
                            <th>Timestamp</th>
                            <th class="text-center" style="width:120px">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int i = ((int)ViewBag.CurrentPage - 1) * (int)ViewBag.PageSize + 1; }
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-muted">@i</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar-icon bg-danger bg-opacity-10 text-danger rounded-circle d-flex align-items-center justify-content-center">
                                            <i class="bi bi-person"></i>
                                        </div>
                                        <span class="fw-semibold">@(item.User?.Name ?? "—")</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-secondary badge-status">
                                        <i class="bi bi-activity me-1"></i>@item.Action
                                    </span>
                                </td>
                                <td>
                                    <i class="bi bi-clock text-muted me-1"></i>
                                    @(item.Timestamp.HasValue ? item.Timestamp.Value.ToString("dd MMM yyyy, HH:mm") : "—")
                                </td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-1">
                                        <a asp-action="Details" asp-route-id="@item.AuditId"
                                           class="btn btn-sm btn-outline-info" title="View Details">
                                            <i class="bi bi-eye-fill"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.AuditId"
                                           class="btn btn-sm btn-outline-warning" title="Edit">
                                            <i class="bi bi-pencil-fill"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.AuditId"
                                           class="btn btn-sm btn-outline-danger" title="Delete">
                                            <i class="bi bi-trash-fill"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                            i++;
                        }
                    </tbody>
                </table>
            </div>
            @await Html.PartialAsync("_Pagination")
        }
        else
        {
            <div class="empty-state">
                <i class="bi bi-shield-lock"></i>
                <p class="fw-semibold mb-1">No audit logs found</p>
                <p class="small mb-0">System actions will appear here once recorded.</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('searchInput').addEventListener('keyup', function () {
            const filter = this.value.toLowerCase();
            document.querySelectorAll('#auditTable tbody tr').forEach(row => {
                row.style.display = row.textContent.toLowerCase().includes(filter) ? '' : 'none';
            });
        });
    </script>
}
