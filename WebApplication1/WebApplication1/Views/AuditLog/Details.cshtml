@model MediPulses.DAL.Entities.AuditLog

@{
    ViewData["Title"] = "Audit Log Details";
}

<div class="container-fluid py-4 px-4">

    <!-- Page Header -->
    <div class="page-header mb-4">
        <div>
            <h2 class="mb-1"><i class="bi bi-shield-lock me-2"></i>Audit Log Details</h2>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Audit Logs</a></li>
                    <li class="breadcrumb-item active">Details</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="data-card">
                <div class="card-header fw-semibold text-secondary small">
                    <i class="bi bi-info-circle me-1"></i>Log #@Model.AuditId
                </div>
                <div class="p-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">Audit ID</dt>
                        <dd class="col-sm-8">@Model.AuditId</dd>

                        <dt class="col-sm-4 text-muted">User</dt>
                        <dd class="col-sm-8">
                            <i class="bi bi-person me-1 text-danger"></i>
                            @(Model.User?.Name ?? "—")
                        </dd>

                        <dt class="col-sm-4 text-muted">Action</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-secondary">@Model.Action</span>
                        </dd>

                        <dt class="col-sm-4 text-muted">Timestamp</dt>
                        <dd class="col-sm-8">
                            <i class="bi bi-clock me-1 text-muted"></i>
                            @(Model.Timestamp.HasValue ? Model.Timestamp.Value.ToString("dd MMM yyyy, HH:mm:ss") : "—")
                        </dd>
                    </dl>
                </div>
                <div class="card-footer d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.AuditId" class="btn btn-outline-warning">
                        <i class="bi bi-pencil-fill me-1"></i>Edit
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i>Back to List
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
